<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Android 13 (API 33) replaced READ_EXTERNAL_STORAGE with per-type media
        permissions. minSdk 33 means this is the only one needed: no legacy
        storage branch anywhere in the code.

        Write access is deliberately not declared here. Modifying photos the
        app does not own is granted per batch at runtime through
        MediaStore.createWriteRequest(), which shows one system dialog for the
        whole queue.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:backupAgent=".FotosistemisBackupAgent"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fotosistemis">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PhotoPreviewActivity"
            android:exported="false"
            android:label="@string/adopt_title" />

        <activity
            android:name=".DestinationsActivity"
            android:exported="false"
            android:label="@string/destinations_title" />

        <activity
            android:name=".SuspectDatesActivity"
            android:exported="false"
            android:label="@string/suspect_title" />

        <activity
            android:name=".GridActivity"
            android:exported="false"
            android:label="@string/grid_title" />

        <activity
            android:name=".DuplicatesActivity"
            android:exported="false"
            android:label="@string/duplicates_title" />

        <activity
            android:name=".CardViewerActivity"
            android:exported="false" />

        <activity
            android:name=".CheckActivity"
            android:exported="false" />

        <activity
            android:name=".QueueActivity"
            android:exported="false"
            android:label="@string/queue_screen_title" />

        <activity
            android:name=".PlacementActivity"
            android:exported="false"
            android:label="@string/placement_title" />

        <activity
            android:name=".ReorganizeActivity"
            android:exported="false"
            android:label="@string/reorganize_title" />

        <activity
            android:name=".DatabaseActivity"
            android:exported="false"
            android:label="@string/database_title" />

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/help_title" />
    </application>

</manifest>