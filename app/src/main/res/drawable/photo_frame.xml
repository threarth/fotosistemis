<?xml version="1.0" encoding="utf-8"?>
<!-- A border around the photo: it separates the picture from the controls
     below it, which on a pale ground otherwise run together. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/white" />
    <stroke
        android:width="1dp"
        android:color="@color/brand_blue_light" />
    <corners android:radius="10dp" />
</shape>
