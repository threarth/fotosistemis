<?xml version="1.0" encoding="utf-8"?>
<!-- Words over a photograph need a ground, or a caption falls on a bright
     sky and disappears. A gradient rather than a bar: it goes dense where
     the text is and fades to nothing above, so it covers the writing
     without cutting a band across the picture. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="90"
        android:startColor="#F2000000"
        android:centerColor="#B3000000"
        android:endColor="#00000000" />
</shape>
