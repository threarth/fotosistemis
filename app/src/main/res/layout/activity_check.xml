<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/checkRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Where it looks and what it looks for, before any number: a count
         nobody can check the meaning of is not evidence of anything. -->
    <TextView
        android:id="@+id/checkTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/checkWhere"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/checkWhat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/checkOutcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Determinate where the total is known, spinning where it is not:
         a bar that lies about progress is worse than no bar. -->
    <ProgressBar
        android:id="@+id/checkProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/checkList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/checkIgnoreButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:text="@string/check_ignore" />

        <Button
            android:id="@+id/checkApplyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:text="@string/check_apply" />
    </LinearLayout>

    <!-- A second answer, where a check has two and neither is the obvious
         one. Hidden for the checks that have a single remedy: a button that
         does nothing here would only be there to be wondered about. -->
    <Button
        android:id="@+id/checkAlternativeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/checkUnignoreButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp" />
</LinearLayout>
