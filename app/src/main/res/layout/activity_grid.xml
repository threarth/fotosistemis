<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gridRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- The bar that belongs to a selection: it appears with one and goes
         with it. What can be done to the chosen photographs is here, beside
         how many they are and the way out — the same three things a gallery
         puts there, in the same place, because that is where a hand
         already goes looking. -->
    <LinearLayout
        android:id="@+id/gridSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_tint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/gridCloseSelection"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="@string/grid_close_selection"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/gridSelectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="34dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/gridActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/gridWhere"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gridHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textSize="11sp" />

    <!-- The grid, with its travelling handle laid over the right edge. -->
    <FrameLayout
        android:id="@+id/gridStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/gridPhotos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:horizontalSpacing="0dp"
            android:numColumns="3"
            android:stretchMode="columnWidth"
            android:verticalSpacing="0dp" />

        <ImageView
            android:id="@+id/gridScrollHandle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginEnd="6dp"
            android:alpha="0"
            android:background="@drawable/scroll_handle"
            android:contentDescription="@string/grid_scroll_handle"
            android:padding="10dp"
            android:src="@drawable/ic_scroll_arrows" />
    </FrameLayout>

    <Button
        android:id="@+id/gridApplyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp" />
</LinearLayout>
