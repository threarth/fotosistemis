<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@color/surface_tint">

        <!-- Everything that chooses what to look at, in one block: full
             screen is that block stepping aside, leaving the photograph and
             the things done to it. -->
        <LinearLayout
            android:id="@+id/selectorBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Scope on the left, the folder being worked on beside it. The two
             answer different questions: where the archive lives, and where the
             work is right now. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sourceButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_source" />

            <Button
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_menu" />

            <Button
                android:id="@+id/stagingButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_staging" />
        </LinearLayout>

        <!-- The folder governs everything under it: the periods offered are
             the periods of the photos in that folder, and the state filter
             counts only those. The indent says so at a glance. -->
        <Button
            android:id="@+id/folderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:drawableStart="@drawable/ic_folder"
            android:drawablePadding="10dp"
            android:ellipsize="middle"
            android:gravity="center_vertical|start"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:text="@string/folder_all" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:background="@drawable/cascade_rule"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cascadeCaption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp" />

                <!-- Gives the photograph the whole screen. The selector is
                     read once and then in the way. -->
                <Button
                    android:id="@+id/fullScreenButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/action_full_screen" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/periodSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Spinner
                    android:id="@+id/scopeSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickRangeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_pick_range" />

            <Button
                android:id="@+id/reloadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_reload" />

       </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            tools:text="0 / 0" />

        <TextView
            android:id="@+id/photoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="IMG_0001.jpg" />

        <!-- Rating and the print mark: both act on the photo in view and
             neither advances, so a judgement can be made without committing to
             where the photo goes. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/starBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <Button
                android:id="@+id/printButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_print_tag" />
        </LinearLayout>

        <!-- Where the photograph actually lives. Scrolling through an
             archive, the folder is often what decides what to do with a
             photo: a whole folder can be left alone, or become a category. -->
        <TextView
            android:id="@+id/photoFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="@color/brand_blue_dark"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/photoTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:text="tag: festatommy2024" />

        <!-- Preview with the four actions laid over it, which saves the two
             rows of buttons they replace. Taps are hit-tested by coordinate and
             flings are read in the same directions, so the overlay is only a
             label: it never intercepts touches itself. -->
        <FrameLayout
            android:id="@+id/mediaStage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/photo_frame"
            android:padding="4dp">

            <!-- Sits under the current photo and shows the neighbouring one, so
                 a drag reveals where it is going instead of cutting to it. -->
            <ImageView
                android:id="@+id/previewAdjacent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/preview_description"
                android:scaleType="fitCenter"
                android:visibility="invisible" />

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:background="#10000000"
                android:contentDescription="@string/preview_description"
                android:scaleType="fitCenter" />

            <!-- Names the decision on the photograph itself. The coloured
                 frame says a decision exists; only the word says which
                 category, and colour alone must never carry meaning. -->
            <TextView
                android:id="@+id/stateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/badge_background"
                android:maxWidth="240dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Legend only: every action is a swipe. Tap zones were removed
                 because "left" is ambiguous, meaning either where the finger
                 starts or where it travels, and the two readings disagree. -->
            <TextView
                android:id="@+id/swipeLegend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_margin="8dp"
                android:alpha="0.55"
                android:background="#66000000"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/swipe_legend"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <!-- Confirms the gesture just made, then fades out. -->
            <TextView
                android:id="@+id/actionFlash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="#CC000000"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- One button per destination folder, built from the database. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/destinationActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tagButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_tag" />

            <Button
                android:id="@+id/dateButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_date_wrong" />

            <Button
                android:id="@+id/openExternalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_open_external" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/undoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_undo" />

            <Button
                android:id="@+id/applyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:text="@string/action_apply" />
        </LinearLayout>

    </LinearLayout>

    <!-- Everything that is not the act of sorting a photo: rare, weighty,
         and out of reach of a thumb that is swiping. -->
    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/drawer_background"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/menu_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/drawerSourceButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_source" />

            <Button
                android:id="@+id/drawerOutputButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_destinations" />

            <Button
                android:id="@+id/drawerQueueButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_queue_plain" />

            <Button
                android:id="@+id/drawerTrashButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_staging_plain" />

            <Button
                android:id="@+id/drawerSystemBinButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_system_bin" />

            <Button
                android:id="@+id/drawerCheckFoldersButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_marginTop="10dp"
                android:text="@string/action_check_folders" />

            <Button
                android:id="@+id/drawerCheckPlacementButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_check_placement" />

            <Button
                android:id="@+id/drawerAdoptButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_adopt" />

            <Button
                android:id="@+id/drawerReorganizeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_reorganize" />

            <Button
                android:id="@+id/drawerSuspectButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_suspect_dates_plain" />

            <Button
                android:id="@+id/drawerPlacementButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_placement" />

            <Button
                android:id="@+id/drawerExportButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:layout_marginTop="10dp"
                android:text="@string/action_export" />

            <Button
                android:id="@+id/drawerImportButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_import" />

            <Button
                android:id="@+id/drawerBackupButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_cloud_backup" />

            <!-- Below this line a mistake costs work: kept apart on purpose. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingBottom="4dp"
                android:text="@string/menu_dangerous"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/drawerRepairDatesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_repair_dates" />

            <Button
                android:id="@+id/drawerRestoreButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_restore" />

            <Button
                android:id="@+id/drawerRescanButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:text="@string/action_rescan" />
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>
