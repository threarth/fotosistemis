<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <RadioButton
        android:id="@+id/copyKeep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical" />

    <ImageView
        android:id="@+id/copyThumb"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="@string/preview_description"
        android:scaleType="centerCrop" />

    <!-- The whole path, wrapped rather than cut: choosing which copy to keep
         is choosing between folders, and a truncated folder decides nothing. -->
    <TextView
        android:id="@+id/copyPath"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:textSize="12sp" />
</LinearLayout>
