<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- The choice and the picture side by side: both are small, and the eye
         needs them together. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/copyKeep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/copyThumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/preview_description"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <!-- Underneath, across the whole card. Beside the thumbnail the column
         was narrow enough to break a path every three words, which is the
         one thing this row exists to make readable: choosing which copy to
         keep is choosing between folders. -->
    <TextView
        android:id="@+id/copyPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="12sp" />

    <!-- What is true of this copy and what is still asked of it. Choosing
         which copy to keep is choosing between histories, not only between
         folders: one may be filed in a category and another may be carrying
         a request nobody has applied yet, and discarding that one throws the
         request away with it. -->
    <TextView
        android:id="@+id/copyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="1dp"
        android:textSize="11sp"
        android:textStyle="italic" />
</LinearLayout>
