<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/groupHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:textColor="@color/ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- One row per copy, built in code: a group holds two or ten.

         A plain column, not a RadioGroup: that only governs radio buttons
         that are its own direct children, and each of these sits inside a
         row with a thumbnail and a path. Left to it, every button in the
         group stayed on at once. The one-of-many rule is enforced in code. -->
    <LinearLayout
        android:id="@+id/groupCopies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
