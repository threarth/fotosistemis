<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nodeRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingEnd="8dp">

    <!-- The arrow opens the folder; the rest of the row chooses it. Two
         separate acts, so they get two separate targets, each big enough
         to hit without aiming. -->
    <TextView
        android:id="@+id/nodeToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textColor="@color/brand_blue_dark"
        android:textSize="18sp" />

    <CheckBox
        android:id="@+id/nodeCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false" />

    <!-- A folder icon distinguishes a branch that can be opened from a leaf
         that only holds photos: the arrow says the same thing, but only to
         someone who has already noticed it is there. -->
    <ImageView
        android:id="@+id/nodeIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/folder_title"
        android:src="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/nodeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/nodePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/ink_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
