<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileFrame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp">

    <ImageView
        android:id="@+id/tileImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/preview_description"
        android:scaleType="centerCrop" />

    <!-- Shown only while a selection is open. A ring on every tile at all
         times would invite a tap that does nothing: outside a selection the
         tap is not what chooses, the hold is. -->
    <ImageView
        android:id="@+id/tileCheck"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|start"
        android:layout_margin="4dp"
        android:contentDescription="@string/grid_check_description"
        android:visibility="gone" />

    <!-- The decision, written on the photograph. A colour alone would say
         that something was decided but never what. -->
    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/badge_background"
        android:ellipsize="end"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
